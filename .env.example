# =============================================
# DATABASE CONFIGURATION
# =============================================

DATABASE_NAME=millete_db
DATABASE_USER=millete_app
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD_APP[SAME PASSWORD]
APP_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_APP[SAME PASSWORD]
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD
DB_PORT=5432

# =============================================
# APPLICATION PORTS
# =============================================

APP_PORT=8080
FRONTEND_PORT=3000

# =============================================
# SECURITY
# =============================================

JASYPT_ENCRYPTOR_PASSWORD=CHANGE_ME_JASYPT
JWT_SECRET=CHANGE_ME_64_CHARS_BASE64
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://127.0.0.1:3000

# =============================================
# SPRING BOOT
# =============================================

SPRING_PROFILES_ACTIVE=prod
LOG_LEVEL=INFO

# =============================================
# FRONTEND
# =============================================

VITE_API_URL=/api/v1
VITE_APP_VERSION=0.2.0

# =============================================
# OPTIONAL AI
# =============================================

# Enable/disable the optional AI integration
MILLETE_AI_ENABLED=false

# ---------------------------------------------
# Verdict - intent classification
# ---------------------------------------------

VERDICT_BASE_URL=http://verdict:8002
VERDICT_DECIDER=millete
VERDICT_CONNECT_TIMEOUT=2s
VERDICT_READ_TIMEOUT=5s

# ---------------------------------------------
# Structured AI - data extraction
# ---------------------------------------------

# OpenAI-compatible API base URL.
#
# Local Ollama:
#   http://localhost:11434/v1
#
# Remote providers may use their own base URL.
MILLETE_AI_BASE_URL=http://localhost:11434/v1

# Ollama does not require a real API key.
# Remote providers can put their token here.
MILLETE_AI_API_KEY=ollama

# Model used for structured data extraction.
MILLETE_AI_MODEL=qwen3:4b-instruct

MILLETE_AI_CONNECT_TIMEOUT=2s
MILLETE_AI_READ_TIMEOUT=60s